# Copy to .env for local development. .env is gitignored — never commit secrets.

APP_ENV=dev

HTTP_PORT=5000
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Matches docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=ipw
DB_PASSWORD=ipw_local_dev
DB_NAME=ipw
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_64_char_hex_string_at_least_32_bytes_long_xxxxxxxx
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# Object storage (S3-compatible). Matches docker-compose.yml minio service.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=ipw
STORAGE_SECRET_KEY=ipw_local_dev
STORAGE_BUCKET=ipw
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/ipw

# lava.top — payment acceptance only (see rework plan). Leave blank until integrated.
LAVA_API_KEY=
LAVA_WEBHOOK_KEY=
LAVA_BASE_URL=https://gate.lava.top
